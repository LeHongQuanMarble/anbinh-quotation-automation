# Shared secret between web app and Mac mini agent (use a long random value)
AGENT_TOKEN=change-me-to-a-long-random-string
# Web app
DB_PATH=storage/app.db
STORAGE_DIR=storage/quotes
LEASE_SECONDS=300
MAX_ATTEMPTS=3
# Agent
SERVER_URL=http://127.0.0.1:8000
WORKER_ID=mac-mini-01
POLL_INTERVAL=3
# off | mock | real  (real = call `codex exec` on the Mac mini)
CODEX_MODE=mock
